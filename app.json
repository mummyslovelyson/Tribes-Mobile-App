{
  "expo": {
    "name": "Tribes & Cliqs",
    "slug": "tribes-and-cliqs",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "tribescliqs",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Tribes & Cliqs to use your camera to scan ticket QR codes at event entrances.",
        "NSMicrophoneUsageDescription": "Allow Tribes & Cliqs to use your microphone to talk to Clqs Bot and record voice notes."
      }
    },
    "android": {
      "package": "com.tribesandcliqs.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C232B",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tribes & Cliqs to use your camera to scan ticket QR codes at event entrances.",
          "microphonePermission": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Tribes & Cliqs to use your microphone to talk to Clqs Bot and record voice notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1C232B",
          "dark": {
            "backgroundColor": "#1C232B"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
